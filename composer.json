{
  "name": "supersendtx/symfony-mailer",
  "description": "Symfony Mailer transport for the SuperSend TX transactional email API",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "symfony",
    "symfony-mailer",
    "email",
    "transactional",
    "supersend",
    "supersendtx",
    "mailer"
  ],
  "authors": [
    {
      "name": "SuperSend TX"
    }
  ],
  "homepage": "https://supersendtx.com",
  "support": {
    "docs": "https://docs.supersendtx.com/frameworks/symfony",
    "issues": "https://github.com/Super-Send/supersendtx-sdks/issues",
    "source": "https://github.com/Super-Send/supersendtx-symfony-mailer"
  },
  "require": {
    "php": ">=8.1",
    "supersendtx/supersendtx": "^0.8.2",
    "symfony/mailer": "^6.2|^7.0",
    "symfony/mime": "^6.2|^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "SuperSendTX\\Symfony\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SuperSendTX\\Symfony\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
